# Copy to .env and fill in real values. Never commit .env, never paste
# any of these into a chat with anyone — including Claude.

# Stripe (Dashboard -> Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_...

# Two SEPARATE webhook endpoints, two separate signing secrets —
# get these after registering each endpoint (see README.md)
STRIPE_WEBHOOK_SECRET_CONNECT=whsec_...
STRIPE_WEBHOOK_SECRET_BILLING=whsec_...

# The 3 subscription Price IDs you create in the Stripe Dashboard
# (Products -> Add Product -> Recurring) for your own subscription plans
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_PRO=price_...

# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where your frontend actually lives — used to build redirect URLs
PLATFORM_URL=http://localhost:5173

PORT=4300
